generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model archivos {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_original            String                       @db.VarChar(255)
  mime_type                  String                       @db.VarChar(100)
  tamano_bytes               BigInt
  storage_key                String                       @unique
  sha256                     String?                      @db.Char(64)
  subido_por                 String?                      @db.Uuid
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  usuarios                   usuarios?                    @relation(fields: [subido_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contratista_capacitaciones contratista_capacitaciones[]
  documentos                 documentos[]
  evidencias_trabajo         evidencias_trabajo[]
  incidente_evidencias       incidente_evidencias[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auditoria {
  id            BigInt   @id @default(autoincrement())
  usuario_id    String?  @db.Uuid
  usuario_email String?  @db.VarChar(255)
  accion        String   @db.VarChar(60)
  entidad       String?  @db.VarChar(60)
  entidad_id    String?  @db.VarChar(60)
  resultado     String   @default("ok")
  datos_antes   Json?
  datos_despues Json?
  ip            String?  @db.Inet
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([accion], map: "ix_aud_accion")
  @@index([entidad, entidad_id], map: "ix_aud_entidad")
  @@index([created_at(sort: Desc)], map: "ix_aud_fecha")
  @@index([usuario_id, created_at(sort: Desc)], map: "ix_aud_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model autorizaciones {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitud_id       String             @db.Uuid
  etapa              Int                @default(1) @db.SmallInt
  decision           String
  usuario_id         String             @db.Uuid
  comentario         String?
  decidido_en        DateTime           @default(now()) @db.Timestamptz(6)
  solicitudes_acceso solicitudes_acceso @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios           usuarios           @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([solicitud_id, etapa])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bloqueos {
  id                                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratista_id                            String?                @db.Uuid
  empresa_id                                String?                @db.Uuid
  tipo                                      String
  motivo                                    String
  incidente_id                              String?                @db.Uuid
  creado_por                                String                 @db.Uuid
  creado_en                                 DateTime               @default(now()) @db.Timestamptz(6)
  levantado_por                             String?                @db.Uuid
  levantado_en                              DateTime?              @db.Timestamptz(6)
  motivo_levantamiento                      String?
  contratistas                              contratistas?          @relation(fields: [contratista_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_bloqueos_creado_porTousuarios    usuarios               @relation("bloqueos_creado_porTousuarios", fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  empresas_contratistas                     empresas_contratistas? @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidentes                                incidentes?            @relation(fields: [incidente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_bloqueos_levantado_porTousuarios usuarios?              @relation("bloqueos_levantado_porTousuarios", fields: [levantado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contratista_id], map: "ix_bloq_contratista", where: raw("(levantado_en IS NULL)"))
  @@index([empresa_id], map: "ix_bloq_empresa", where: raw("(levantado_en IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capacitaciones {
  id                         Int                          @id @default(autoincrement())
  codigo                     String                       @unique @db.VarChar(40)
  nombre                     String                       @db.VarChar(150)
  descripcion                String?
  vigencia_meses             Int?
  contratista_capacitaciones contratista_capacitaciones[]
  requisitos_tipo_trabajo    requisitos_tipo_trabajo[]
}

model checklist_items {
  id                   Int                    @id @default(autoincrement())
  plantilla_id         Int
  orden                Int                    @db.SmallInt
  descripcion          String
  obligatorio          Boolean                @default(true)
  checklist_plantillas checklist_plantillas   @relation(fields: [plantilla_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  checklist_respuestas checklist_respuestas[]

  @@unique([plantilla_id, orden])
}

model checklist_plantillas {
  id              Int               @id @default(autoincrement())
  tipo_trabajo_id Int
  nombre          String            @db.VarChar(150)
  activa          Boolean           @default(true)
  checklist_items checklist_items[]
  tipos_trabajo   tipos_trabajo     @relation(fields: [tipo_trabajo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model checklist_respuestas {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitud_id           String                 @db.Uuid
  contratista_id         String                 @db.Uuid
  item_id                Int
  cumple                 Boolean
  observacion            String?
  respondido_en          DateTime               @default(now()) @db.Timestamptz(6)
  checklist_items        checklist_items        @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitud_contratistas solicitud_contratistas @relation(fields: [solicitud_id, contratista_id], references: [solicitud_id, contratista_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([solicitud_id, contratista_id, item_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contratista_capacitaciones {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratista_id    String         @db.Uuid
  capacitacion_id   Int
  fecha_realizacion DateTime       @db.Date
  fecha_vencimiento DateTime?      @db.Date
  archivo_id        String?        @db.Uuid
  estado_revision   String         @default("pendiente")
  revisado_por      String?        @db.Uuid
  revisado_en       DateTime?      @db.Timestamptz(6)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  archivos          archivos?      @relation(fields: [archivo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capacitaciones    capacitaciones @relation(fields: [capacitacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contratistas      contratistas   @relation(fields: [contratista_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios          usuarios?      @relation(fields: [revisado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([contratista_id, capacitacion_id, fecha_realizacion])
  @@index([contratista_id, capacitacion_id], map: "ix_cc_contratista")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model contratistas {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id                 String                       @db.Uuid
  usuario_id                 String?                      @unique @db.Uuid
  documento_identidad        String                       @unique @db.VarChar(30)
  nombres                    String                       @db.VarChar(100)
  apellidos                  String                       @db.VarChar(100)
  email                      String?                      @db.Citext
  telefono                   String?                      @db.VarChar(30)
  cargo                      String?                      @db.VarChar(100)
  estado                     String                       @default("activo")
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  bloqueos                   bloqueos[]
  contratista_capacitaciones contratista_capacitaciones[]
  empresas_contratistas      empresas_contratistas        @relation(fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios                   usuarios?                    @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentos                 documentos[]
  incidentes                 incidentes[]
  solicitud_contratistas     solicitud_contratistas[]

  @@index([empresa_id], map: "ix_contratistas_empresa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
