  revocada_por                                 String?                   @db.Uuid
  motivo_revocacion                            String?
  usuarios_credenciales_emitida_porTousuarios  usuarios                  @relation("credenciales_emitida_porTousuarios", fields: [emitida_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permisos_trabajo                             permisos_trabajo?         @relation(fields: [permiso_trabajo_id, solicitud_id], references: [id, solicitud_id], onDelete: NoAction, onUpdate: NoAction)
  usuarios_credenciales_revocada_porTousuarios usuarios?                 @relation("credenciales_revocada_porTousuarios", fields: [revocada_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
